import 'package:flexfund_app/services/gemini_service.dart';
import 'package:flutter/material.dart';
import 'package:flexfund_app/theme/color_theme.dart';

class CampaignChatAssistant extends StatefulWidget {
  const CampaignChatAssistant({Key? key}) : super(key: key);

  @override
  _CampaignChatAssistantState createState() => _CampaignChatAssistantState();
}

class _CampaignChatAssistantState extends State<CampaignChatAssistant> {
  final TextEditingController _nameController = TextEditingController();
  final TextEditingController _goalController = TextEditingController();
  final TextEditingController _amountController = TextEditingController();

  String generatedDescription = '';
  bool isLoading = false;

  void _generateDescription() async {
    setState(() {
      isLoading = true;
      generatedDescription = '';
    });

    final name = _nameController.text.trim();
    final goal = _goalController.text.trim();
    final targetAmount = _amountController.text.trim();

    if (name.isNotEmpty && goal.isNotEmpty && targetAmount.isNotEmpty) {
      final description = await GeminiService.generateDescription(
        name: name,
        goal: goal,
        targetAmount: targetAmount,
      );

      setState(() {
        generatedDescription = description;
        isLoading = false;
      });
    } else {
      setState(() {
        generatedDescription =
            'Please fill out all fields to generate a description.';
        isLoading = false;
      });
    }
  }

  void _showEditDialog(String initialText) {
    final TextEditingController _editController =
        TextEditingController(text: initialText);

    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Edit Description'),
        content: TextField(
          controller: _editController,
          maxLines: 6,
          decoration: const InputDecoration(
            border: OutlineInputBorder(),
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Cancel'),
          ),
          ElevatedButton(
            onPressed: () {
              Navigator.pop(context);
              Navigator.pop(context, _editController.text.trim());
              ScaffoldMessenger.of(context).showSnackBar(
                const SnackBar(content: Text('Description selected!')),
              );
            },
            child: const Text('Use this'),
          ),
        ],
      ),
    );
  }

  Widget _buildChatBubble(String text) {
    return GestureDetector(
      onTap: () => _showEditDialog(text),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          CircleAvatar(
            radius: 16,
            backgroundColor: Colors.green.shade700,
            child: const Icon(Icons.smart_toy, size: 16, color: Colors.white),
          ),
          const SizedBox(width: 10),
          Flexible(
            child: Container(
              padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
              margin: const EdgeInsets.symmetric(vertical: 8),
              decoration: BoxDecoration(
                color: const Color(0xFFE1FFC7),
                borderRadius: const BorderRadius.only(
                  topRight: Radius.circular(16),
                  topLeft: Radius.circular(16),
                  bottomRight: Radius.circular(16),
                ),
              ),
              child: Text(
                text,
                style: const TextStyle(fontSize: 16),
              ),
            ),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return SafeArea(
      child: Scaffold(
        appBar: AppBar(
          title: const Text('Campaign Chat Assistant'),
          centerTitle: true,
          backgroundColor: Colors.white,
          foregroundColor: Colors.black,
          elevation: 0,
        ),
        body: Padding(
          padding: const EdgeInsets.all(20.0),
          child: SingleChildScrollView(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text('Please fill in the fields below to generate a suitable description for your campaign',
                style:FlexFundTheme.headlineSmall),
                SizedBox(height:30),
                TextFormField(
                  controller: _nameController,
                  decoration: FlexFundTheme.textFieldDecoration(
                    labelText: 'Campaign Name',
                    prefixIcon: Icons.campaign,
                  ),
                ),
                
                const SizedBox(height: 10),
                TextFormField(
                  controller: _goalController,
                  decoration: FlexFundTheme.textFieldDecoration(
                    labelText: 'Campaign Goal',
                    prefixIcon: Icons.flag_outlined,
                  ),
                ),
                const SizedBox(height: 10),
                TextFormField(
                  controller: _amountController,
                  decoration: FlexFundTheme.textFieldDecoration(
                    labelText: 'Target Amount',
                    prefixIcon: Icons.attach_money_outlined,
                  ),
                  keyboardType: TextInputType.number,
                ),
                const SizedBox(height: 20),
                SizedBox(
                  width: double.infinity,
                  child: OutlinedButton(
                    onPressed: _generateDescription,
           style: OutlinedButton.styleFrom(
    side: BorderSide(
      color: FlexFundTheme.primaryGreen,
      width: 2,            
    ),
    shape: RoundedRectangleBorder(
      borderRadius: BorderRadius.circular(8),
    ),
  ),
                    child: isLoading
                        ? const SizedBox(
                            height: 18,
                            width: 18,
                            child: CircularProgressIndicator(
                              strokeWidth: 2.5,
                              color: FlexFundTheme.primaryGreen,
                            ),
                          )
                        : const Text('Generate Description'),
                  ),
                ),
                const SizedBox(height: 30),
                if (generatedDescription.isNotEmpty)
                  Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      const Text(
                        'Tap the description below to edit or use it:',
                        style: TextStyle(
                          fontWeight: FontWeight.bold,
                          fontSize: 16,
                        ),
                      ),
                      const SizedBox(height: 12),
                      _buildChatBubble(generatedDescription),
                    ],
                  ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}